# Copy to .env for local configuration. Never commit real credentials.
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DB_ENABLED=false
JARVIS_DB_PATH=data/jarvis.db
JARVIS_TIMEZONE=Asia/Kolkata
JARVIS_LOG_LEVEL=INFO
JARVIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

JARVIS_LLM_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP=

JARVIS_GITHUB_ENABLED=false
JARVIS_GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

JARVIS_JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
