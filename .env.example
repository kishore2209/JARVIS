# Configuration reference: export these values in your shell; the launcher does not auto-load .env. Never commit real credentials.
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DB_ENABLED=false
JARVIS_DB_PATH=data/jarvis.db
JARVIS_TIMEZONE=Asia/Kolkata
JARVIS_LOG_LEVEL=INFO
JARVIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

JARVIS_LLM_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP=

JARVIS_GITHUB_ENABLED=false
JARVIS_GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

JARVIS_JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# API owner token is server-side. Required for non-loopback binding or staging/production.
JARVIS_API_TOKEN=
JARVIS_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,[::1]

# Optional built dashboard and read-only data provider.
JARVIS_SERVE_UI=false
JARVIS_MARKET_PROVIDER=MOCK

# Fixed HTTPS MCP endpoint and resource aliases, configured server-side only.
JARVIS_MCP_HTTP_ENABLED=false
JARVIS_MCP_ENDPOINT=
JARVIS_MCP_RESOURCES={}
JARVIS_MCP_TOKEN=

# Keep backup keys outside the repository and separate from encrypted snapshots.
JARVIS_BACKUP_KEY=
